# Copy to .env for local development. Never commit .env.
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://postgres:postgres@localhost:5432/catalift-app?sslmode=disable
# Tracing is off until this is set (OTLP over HTTP, e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Uploaded photos and export files (the VM's data disk in prod).
DATA_DIR=data
# Channel rule files (REQ-017).
CHANNELS_DIR=config/channels
# Empty uses the free local stand-in instead of OpenRouter. Set it only in .env.
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-haiku-4.5
# false only for a plain-HTTP local run; prod serves HTTPS.
SECURE_COOKIES=false
