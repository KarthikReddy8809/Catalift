# Terraform: state and plans are never in git; the lock file is.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.plans/
crash.log
crash.*.log
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Local environment
.env

# Bearing
.scratch/
deliverables/
.bearing/state/
.claude/settings.local.json
# 0-byte placeholders the Claude Code sandbox holds while a command runs
/.bashrc
/.bash_profile
/.zshrc
/.zprofile
/.profile
/.ripgreprc
/.gitconfig
